# Required
NODE_ENV=production
# Signs session JWTs — must be a long, cryptographically-random string (min 32 chars,
# server refuses to boot otherwise). Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-with-random-64-char-string
CORS_ORIGINS=https://vertix.fr

# Discord OAuth — the ONLY login method, so these are required for accounts to work.
# DISCORD_REDIRECT_URI must be the same origin players open the game on (vertix.fr),
# and must be registered as a redirect URI in the Discord developer portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://vertix.fr/api/auth/discord/callback
