{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "vertix",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["dev"],
			"port": 5173
		},
		{
			"name": "vertix-prod",
			"runtimeExecutable": "pwsh",
			"runtimeArgs": [
				"-NoProfile",
				"-Command",
				"$env:NODE_ENV='production'; $env:TRUST_PROXY='1'; node --env-file=.env --import ./server/import-hooks.ts server/index.ts"
			],
			"port": 1118
		}
	]
}
